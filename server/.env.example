# Copy to .env and adjust. Only read on the very first start (the values are
# then stored in the database and can be changed from the app's Parent mode).
WIJKLOPER_FAMILY_NAME=Our family
WIJKLOPER_PAIRING_CODE=12345678
WIJKLOPER_PARENT_PIN=1234
# 1 = serve interactive API docs at /docs, 0 = hide them
WIJKLOPER_ENABLE_DOCS=1
# Time zone of the family (decides what "today" is for streaks)
WIJKLOPER_TZ=Europe/Amsterdam
# Docker network that the reverse proxy is attached to
PROXY_NETWORK=proxy

# --- Nightly import from the distributor's portal (optional) ---
# Used only by `app.cli sync-spreadit`; the API never calls the portal.
SPREADIT_USERNAME=your-gebruikerscode
SPREADIT_PASSWORD=your-wachtwoord
SPREADIT_DISTRICT=3772-013
# Comma separated. Only these products are imported; everything else in the
# feed (weekly leaflets) is ignored.
SPREADIT_PRODUCTS=Barneveldse Krant
